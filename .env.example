# Copy to apps/api/.env
DATABASE_URL="postgresql://stocksense:stocksense@localhost:5433/stocksense?connection_limit=20&pool_timeout=10"
TEST_DATABASE_URL="postgresql://stocksense:stocksense@localhost:5433/stocksense_test?connection_limit=20&pool_timeout=10"
# Port used by `pnpm db:start` (embedded Postgres)
PG_PORT=5433
APP_TIMEZONE="Asia/Kolkata"
# Password for every seeded demo account
SEED_PASSWORD="change-me-demo-pass"
SMTP_HOST=localhost
SMTP_PORT=1025
