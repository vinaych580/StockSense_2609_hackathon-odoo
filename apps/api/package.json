{
  "name": "@stocksense/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:start": "tsx scripts/db.ts",
    "db:migrate": "prisma migrate deploy && tsx scripts/ensure-system-data.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:seed": "tsx src/seed/index.ts",
    "seed:master": "tsx src/seed/index.ts master",
    "db:check": "tsx scripts/check.ts",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "6.19.3",
    "@stocksense/shared": "workspace:*",
    "dotenv": "^17.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "embedded-postgres": "16.14.0-beta.17",
    "prisma": "6.19.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
