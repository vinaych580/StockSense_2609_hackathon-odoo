// StockSense data model. Stock lives in exactly two tables: stock_move (append-only ledger)
// and stock_quant (balance per product and internal location). Only src/inventory/posting.ts writes them.
// CHECK constraints, the append-only trigger and the partial unique index live in the
// hand-written SQL migration (Prisma's schema language can't express them).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MANAGER
  STAFF

  @@map("role")
}

enum LocationType {
  INTERNAL
  VENDOR
  CUSTOMER
  ADJUSTMENT

  @@map("location_type")
}

enum PartnerKind {
  SUPPLIER
  CUSTOMER

  @@map("partner_kind")
}

enum Uom {
  UNIT
  BOX
  KG
  L
  M

  @@map("uom")
}

enum OperationType {
  RECEIPT
  DELIVERY
  TRANSFER
  ADJUSTMENT

  @@map("operation_type")
}

enum OperationStatus {
  DRAFT
  WAITING
  READY
  DONE
  CANCELED

  @@map("operation_status")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.VarChar(254)
  name         String   @db.VarChar(120)
  passwordHash String   @map("password_hash")
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions            Session[]
  passwordResetOtps   PasswordResetOtp[]
  operationsCreated   Operation[]        @relation("OperationCreatedBy")
  operationsValidated Operation[]        @relation("OperationValidatedBy")
  operationsCanceled  Operation[]        @relation("OperationCanceledBy")
  operationsOwned     Operation[]        @relation("OperationResponsible")
  moves               StockMove[]
  idempotencyKeys     IdempotencyKey[]
  auditLogs           AuditLog[]

  @@map("user")
}

model Session {
  /// SHA-256 of the random 32-byte token held in the cookie.
  id         String   @id
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  ip         String?  @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("session")
}

model PasswordResetOtp {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @unique @map("user_id") @db.Uuid
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("password_reset_otp")
}

model Warehouse {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(10)
  name      String   @db.VarChar(120)
  address   String?  @db.VarChar(500)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  locations    Location[]
  operations   Operation[]
  reorderRules ReorderRule[]
  sequences    SequenceCounter[]

  @@map("warehouse")
}

model Location {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId String?      @map("warehouse_id") @db.Uuid
  code        String       @db.VarChar(20)
  name        String       @db.VarChar(120)
  type        LocationType @default(INTERNAL)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  warehouse       Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  quants          StockQuant[]
  operationsFrom  Operation[]  @relation("OperationSource")
  operationsTo    Operation[]  @relation("OperationDest")
  movesFrom       StockMove[]  @relation("MoveFrom")
  movesTo         StockMove[]  @relation("MoveTo")

  @@unique([warehouseId, code])
  @@map("location")
}

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("category")
}

model Product {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stored trimmed and upper-case.
  sku        String   @unique @db.VarChar(40)
  name       String   @db.VarChar(120)
  categoryId String?  @map("category_id") @db.Uuid
  uom        Uom      @default(UNIT)
  unitCost   Decimal? @map("unit_cost") @db.Decimal(12, 2)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category     Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  quants       StockQuant[]
  moves        StockMove[]
  lines        OperationLine[]
  reorderRules ReorderRule[]

  @@map("product")
}

model ReorderRule {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  minQty      Decimal  @map("min_qty") @db.Decimal(14, 3)
  maxQty      Decimal  @map("max_qty") @db.Decimal(14, 3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([productId, warehouseId])
  @@map("reorder_rule")
}

model Partner {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String      @db.VarChar(120)
  kind      PartnerKind
  email     String?     @db.VarChar(254)
  phone     String?     @db.VarChar(40)
  address   String?     @db.VarChar(500)
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  operations Operation[]

  @@map("partner")
}

model Operation {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// For example WH1/IN/00012.
  reference        String          @unique @db.VarChar(40)
  type             OperationType
  status           OperationStatus @default(DRAFT)
  warehouseId      String          @map("warehouse_id") @db.Uuid
  sourceLocationId String          @map("source_location_id") @db.Uuid
  destLocationId   String          @map("dest_location_id") @db.Uuid
  partnerId        String?         @map("partner_id") @db.Uuid
  responsibleId    String?         @map("responsible_id") @db.Uuid
  scheduledDate    DateTime?       @map("scheduled_date") @db.Timestamptz(3)
  pickedAt         DateTime?       @map("picked_at") @db.Timestamptz(3)
  packedAt         DateTime?       @map("packed_at") @db.Timestamptz(3)
  notes            String?         @db.VarChar(2000)
  createdById      String          @map("created_by") @db.Uuid
  validatedById    String?         @map("validated_by") @db.Uuid
  validatedAt      DateTime?       @map("validated_at") @db.Timestamptz(3)
  canceledById     String?         @map("canceled_by") @db.Uuid
  canceledAt       DateTime?       @map("canceled_at") @db.Timestamptz(3)
  version          Int             @default(0)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  sourceLocation Location        @relation("OperationSource", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destLocation   Location        @relation("OperationDest", fields: [destLocationId], references: [id], onDelete: Restrict)
  partner        Partner?        @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  responsible    User?           @relation("OperationResponsible", fields: [responsibleId], references: [id], onDelete: Restrict)
  createdBy      User            @relation("OperationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  validatedBy    User?           @relation("OperationValidatedBy", fields: [validatedById], references: [id], onDelete: Restrict)
  canceledBy     User?           @relation("OperationCanceledBy", fields: [canceledById], references: [id], onDelete: Restrict)
  lines          OperationLine[]
  moves          StockMove[]

  @@index([type, status])
  @@index([warehouseId, status])
  @@index([scheduledDate])
  @@map("operation")
}

model OperationLine {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operationId     String   @map("operation_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  /// Receipts, deliveries, transfers: the quantity to move.
  quantity        Decimal? @db.Decimal(14, 3)
  /// Adjustments: the counted quantity.
  countedQuantity Decimal? @map("counted_quantity") @db.Decimal(14, 3)
  /// Adjustments: the balance when the count was entered.
  balanceAtCount  Decimal? @map("balance_at_count") @db.Decimal(14, 3)
  /// Set at validation: the signed quantity actually posted.
  postedQuantity  Decimal? @map("posted_quantity") @db.Decimal(14, 3)

  operation Operation   @relation(fields: [operationId], references: [id], onDelete: Restrict)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  moves     StockMove[]

  @@unique([operationId, productId])
  @@map("operation_line")
}

model StockQuant {
  productId  String   @map("product_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  quantity   Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([productId, locationId])
  @@index([locationId])
  @@map("stock_quant")
}

model StockMove {
  id              BigInt   @id @default(autoincrement())
  operationId     String   @map("operation_id") @db.Uuid
  operationLineId String   @map("operation_line_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  fromLocationId  String   @map("from_location_id") @db.Uuid
  toLocationId    String   @map("to_location_id") @db.Uuid
  quantity        Decimal  @db.Decimal(14, 3)
  doneAt          DateTime @map("done_at") @db.Timestamptz(3)
  doneById        String   @map("done_by") @db.Uuid

  operation     Operation     @relation(fields: [operationId], references: [id], onDelete: Restrict)
  operationLine OperationLine @relation(fields: [operationLineId], references: [id], onDelete: Restrict)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  fromLocation  Location      @relation("MoveFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation    Location      @relation("MoveTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  doneBy        User          @relation(fields: [doneById], references: [id], onDelete: Restrict)

  @@index([productId, doneAt(sort: Desc)])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([operationId])
  @@map("stock_move")
}

/// Gap-free reference numbers per (warehouse, type), incremented inside the create transaction.
model SequenceCounter {
  warehouseId String        @map("warehouse_id") @db.Uuid
  type        OperationType
  next        Int           @default(1)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@id([warehouseId, type])
  @@map("sequence_counter")
}

model IdempotencyKey {
  userId       String   @map("user_id") @db.Uuid
  key          String   @db.VarChar(100)
  method       String   @db.VarChar(10)
  path         String   @db.VarChar(300)
  requestHash  String   @map("request_hash") @db.VarChar(64)
  statusCode   Int      @map("status_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([userId, key])
  @@index([createdAt])
  @@map("idempotency_key")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(60)
  entity    String   @db.VarChar(60)
  entityId  String   @map("entity_id") @db.VarChar(60)
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entity, entityId])
  @@map("audit_log")
}
